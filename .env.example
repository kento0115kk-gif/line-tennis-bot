# LINE Messaging API の設定
# LINE Developers コンソール（https://developers.line.biz/console/）から取得する。

# チャネルアクセストークン（長期）。メッセージ送信に必須。
LINE_CHANNEL_ACCESS_TOKEN=

# チャネルシークレット。Webhook の署名検証に使う。
# 送信（push）だけなら未設定でも動作する。
LINE_CHANNEL_SECRET=

# 送信先の userId / groupId / roomId。
# 空にすると友だち全員への broadcast になる。
LINE_TO=

# 通知を止める時間帯（0-23）。既定は 23:00〜7:00。
QUIET_START=23
QUIET_END=7

# 平日に通知する下限時刻（土日祝は終日通知）。既定は 19。
WEEKDAY_FROM_HOUR=19
